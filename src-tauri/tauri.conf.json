{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Formwright",
  "version": "0.1.0",
  "identifier": "app.formwright.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Formwright",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com https://api.github.com; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Simple, open-source CAD with an AI assistant",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "publisher": "Formwright contributors",
    "copyright": "Copyright \u00a9 2026 Formwright contributors",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://github.com/GPTmadeit/formwright",
    "longDescription": "Build 3D models from simple shapes and holes, or describe what you want and watch an AI assistant build it step by step. Export STL for 3D printing.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "graphics"
      },
      "rpm": {
        "release": "1"
      }
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NzQ1MDY1MEEwRkYwRkEKUldUNjhBOEtaVkIwcFIzQjhHSWxmczdFN1lXc1lPS2s1cGdlNDN4dXUwYmEvamJHSk93UGdyZ2QK",
      "endpoints": [
        "https://github.com/GPTmadeit/formwright/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
